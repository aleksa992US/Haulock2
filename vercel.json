{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/rate-con/scan/route.ts": {
      "maxDuration": 60
    },
    "app/api/verify/route.ts": {
      "maxDuration": 30
    },
    "app/api/cron/fraud-trends/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/watchlist-updates/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/weekly-digest/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/abandoned-carts/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/fraud-trends",
      "schedule": "0 14 * * 4"
    },
    {
      "path": "/api/cron/watchlist-updates",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/abandoned-carts",
      "schedule": "15 * * * *"
    }
  ]
}
